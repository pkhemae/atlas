{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["TAURI_DEV_HOST"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".nitro/**", "dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": false
    }
  }
}
